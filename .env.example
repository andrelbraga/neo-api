# Exemplo de variáveis da API. Copie para .env e ajuste. Nunca suba o .env.
APP_ENV=local
PORT=8081
# Banco do docker compose local (make db-up). Em produção, a URL do Postgres do Railway.
DATABASE_URL=postgres://neo360:neo360@localhost:5433/neo360?sslmode=disable
# Schema próprio quando o banco é dividido com outro projeto (ADR-0018). Vazio usa o padrão (public).
DB_SCHEMA=
# Obrigatório fora do ambiente local: gere um valor longo e aleatório.
JWT_SECRET=
JWT_EXPIRY_HOURS=12
# Origens do app que podem chamar a API, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5174
